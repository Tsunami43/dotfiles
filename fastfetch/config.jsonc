{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Art is built by img2art.py: logo_photo_* from ~/Pictures/bleach.jpeg,
  // logo_paste_* rescaled from the hand-supplied logo_paste_65.txt.
  // Braille packs a 2x4 dot matrix into every cell, so it is plain text and
  // type "file" tints the whole drawing with the color below.
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo_inv.txt",
    "color": { "1": "white" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "break",
    "break",
    "break",
    { "type": "separator", "string": "─", "length": 17 },
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "break",
    "colors"
  ]
}
