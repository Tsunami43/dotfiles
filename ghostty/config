# Font Configuration
# Maple Mono NF — rounded terminals, a true cursive italic for comments, and the
# nerd-font glyphs lualine and yazi draw. Package: maplemono-nf-unhinted (AUR).
font-family = Maple Mono NF
font-size = 12

# Window Configuration
# Start in $HOME instead of inheriting the launcher's cwd (the single-instance
# daemon keeps whatever directory the first window was spawned from).
working-directory = home
window-decoration = false
window-padding-x = 0
window-padding-y = 0
# Fill sub-cell leftover with neighbor cell color (removes the dark strip under lualine)
window-padding-color = extend
window-padding-balance = true
# Opaque. The theme's own ground is what the editor is read against now, so
# nothing from the wallpaper competes with the syntax colours sitting on it.
background-opacity = 1

# Cursor Configuration
cursor-style = block
cursor-style-blink = true

# Scrollback (value is in bytes — 10 MB ≈ tens of thousands of lines)
scrollback-limit = 10000000

# Terminal features
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false

# Disable annoying copied to clipboard
app-notifications = no-clipboard-copy,no-config-reload

# Skip paste confirmation (multi-line/escape codes) and OSC52 clipboard reads
clipboard-paste-protection = false
clipboard-read = allow
clipboard-write = allow

# Key bindings for common actions
#keybind = ctrl+c=copy_to_clipboard
#keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# An unfocused split recedes towards the ground the theme keeps under floats,
# rather than towards the bluish grey this was left on by the old palette.
unfocused-split-opacity = 0.7
unfocused-split-fill = #0f0c0a

# Tab configuration
gtk-titlebar = false

# Auto-attach tmux session "main" on launch (creates if missing)
command = tmux 

# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title,no-cursor
keybind = shift+enter=text:\n

# Rando stuff
gtk-single-instance = true

# Cendre · hard, from themes/cendre — generated by ~/Projects/me/cendre.
# Nothing is overridden here on purpose: the theme already sets foreground and
# all sixteen slots, and a local override is exactly how the terminal drifts
# out of step with the editor sitting inside it.
theme = cendre
