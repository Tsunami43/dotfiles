# Font Configuration
font-size = 12

# Window Configuration
window-decoration = false
window-padding-x = 0
window-padding-y = 0
# Fill sub-cell leftover with neighbor cell color (removes the dark strip under lualine)
window-padding-color = extend
window-padding-balance = true
background-opacity = 1.0
background-blur-radius = 32

# Cursor Configuration
cursor-style = block
cursor-style-blink = true

# Scrollback
scrollback-limit = 3023

# Terminal features
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false

# Disable annoying copied to clipboard
app-notifications = no-clipboard-copy,no-config-reload

# Skip paste confirmation (multi-line/escape codes) and OSC52 clipboard reads
clipboard-paste-protection = false
clipboard-read = allow
clipboard-write = allow

# Key bindings for common actions
#keybind = ctrl+c=copy_to_clipboard
#keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# Material 3 UI elements
unfocused-split-opacity = 0.7
unfocused-split-fill = #44464f

# Tab configuration
gtk-titlebar = false

# Auto-attach tmux session "main" on launch (creates if missing)
#command = tmux new-session -A -s main

# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title,no-cursor
keybind = shift+enter=text:\n

# Rando stuff
gtk-single-instance = true

# Dank color generation
theme = dankcolors
