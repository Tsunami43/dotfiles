htop_history
# Local backup of the pre-tuning htoprc; git history covers this now
htoprc.bak

# === Fully private application data ===
# Electron apps: cookies, session tokens, local cache, IndexedDB
Slack/
discord/
obsidian/
# Hydra game launcher (Electron): caches, DBs, logs, downloaded redist installers
hydralauncher/

# Firefox: passwords, history, cookies, profiles — keep only user.js
mozilla/*
!mozilla/firefox/
mozilla/firefox/*
!mozilla/firefox/user.js

# Chromium-family browsers: profiles, cookies, caches. Right now these dirs hold nothing
# but the Claude Code native-messaging manifest (ignored further down), yet they fill with
# private state the moment the browser is launched.
google-chrome
BraveSoftware/
chromium/
microsoft-edge/
opera/
vivaldi/

# Binary GNOME settings database with user state
dconf/

# Contains PulseAudio auth cookie
pulse/

# LibreOffice profile: recent docs, dictionaries, history
libreoffice/

# Local tool cache/state
procps/
yay/

# quickshell configs are their own projects now — nothingshell lives in its own git repository,
# cloned into quickshell/nothingshell. Nothing under here belongs to the dotfiles.
quickshell/*

# Everything the shell writes about itself: settings.json (rewritten on every application launch,
# since it counts them to sort the launcher, and a log of what you use besides) and the Hyprland
# fragments its settings pages regenerate in full. All of it is output, not configuration anyone
# edits here, and it is recreated on demand — the shell writes a fresh monitors.conf the next time
# a display setting changes.
nothingshell/

# Next.js CLI telemetry state (anonymousId, salt)
nextjs-nodejs/

# Chrome for Testing: local cache, crash reports — not config
google-chrome-for-testing/

# Claude Code local settings (settings.local.json)
.claude/
com.anthropic.*

# Contains lastVisited paths from Qt file dialogs
QtProject.conf

# Machine-specific local path only
PortProton.conf

# Hardhat local state: vars.json holds private keys / API tokens
hardhat-nodejs/

# DB client (Sqlit): credentials.json with real passwords, connections.json
# with prod hosts, queries/ with production SQL
sqlit/

# === Generic cache/state/secret patterns ===
**/Cache/
**/Code Cache/
**/GPUCache/
**/DawnGraphiteCache/
**/DawnWebGPUCache/
**/Crashpad/
**/blob_storage/
**/Service Worker/
**/Session Storage/
**/Local Storage/
**/IndexedDB/
**/Local State
**/Cookies
**/Cookies-journal
**/*.sqlite
**/*.sqlite-journal
**/*.sqlite-wal
**/*.sqlite-shm
**/*.ldb
**/*.log
**/*.tmp
**/*.swp
**/*.swo
**/*~
**/*.bak
**/*.bak-*
**/*.bak.*
**/.DS_Store

# Erlang/Elixir crash dumps
**/erl_crash.dump

# Secrets and credentials
**/secrets/
**/*token*
**/*secret*
**/*.pem
**/*.key
**/*.env
**/.env
**/.env.*
