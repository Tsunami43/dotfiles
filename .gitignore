# === Fully private application data ===
# Electron apps: cookies, session tokens, local cache, IndexedDB
Slack/
discord/
obsidian/
# Hydra game launcher (Electron): caches, DBs, logs, downloaded redist installers
hydralauncher/

# Firefox: passwords, history, cookies, profiles — keep only user.js
google-chrome
mozilla/*
!mozilla/firefox/
mozilla/firefox/*
!mozilla/firefox/user.js

# Binary GNOME settings database with user state
dconf/

# Contains PulseAudio auth cookie
pulse/

# LibreOffice profile: recent docs, dictionaries, history
libreoffice/

# Local tool cache/state
procps/
yay/

# quickshell: track our own shell (mine); ignore any other/generated configs
quickshell/*
!quickshell/mine/

# Next.js CLI telemetry state (anonymousId, salt)
nextjs-nodejs/

# Chrome for Testing: local cache, crash reports — not config
google-chrome-for-testing/

# Claude Code local settings (settings.local.json)
.claude/
com.anthropic.*

# Contains lastVisited paths from Qt file dialogs
QtProject.conf

# Machine-specific local path only
PortProton.conf

# Hardhat local state: vars.json holds private keys / API tokens
hardhat-nodejs/

# DB client (Sqlit): credentials.json with real passwords, connections.json
# with prod hosts, queries/ with production SQL
sqlit/

# === Generic cache/state/secret patterns ===
**/Cache/
**/Code Cache/
**/GPUCache/
**/DawnGraphiteCache/
**/DawnWebGPUCache/
**/Crashpad/
**/blob_storage/
**/Service Worker/
**/Session Storage/
**/Local Storage/
**/IndexedDB/
**/Local State
**/Cookies
**/Cookies-journal
**/*.sqlite
**/*.sqlite-journal
**/*.sqlite-wal
**/*.sqlite-shm
**/*.ldb
**/*.log
**/*.tmp
**/*.swp
**/*.swo
**/*~
**/*.bak
**/*.bak-*
**/*.bak.*
**/.DS_Store

# Erlang/Elixir crash dumps
**/erl_crash.dump

# Secrets and credentials
**/secrets/
**/*token*
**/*secret*
**/*.pem
**/*.key
**/*.env
**/.env
**/.env.*
