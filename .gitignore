# Whitelist approach: ignore everything at the top level,
# then explicitly re-include the configs worth tracking.
/*

!/.gitignore
!/README.md
!/LICENSE

# --- Desktop / Hyprland / Omarchy ---
!/hypr/
!/omarchy/
!/autostart/
!/environment.d/
!/systemd/
!/xdg-desktop-portal/
!/hyprland-preview-share-picker/
!/wireplumber/
!/fcitx5/
!/mimeapps.list
!/hyprland-mimeapps.list
!/xdg-terminals.list
!/user-dirs.dirs
!/chromium-flags.conf

# --- Terminals / shell / CLI tools ---
!/alacritty/
!/kitty/
!/ghostty/
!/foot/
!/tmux/
!/starship.toml
!/btop/
!/lazygit/
!/imv/
!/nvim/
!/git/
!/herdr/

# --- Apps (only safe files, see excludes below) ---
!/superwhisper/
!/opencode/

# ===== Excludes inside whitelisted dirs =====

# Backups, logs, lock files
*.bak
*.bak.*
*.log
*.lock
.plugins.lock

# Omarchy: sample hooks/templates and symlink to a system package
/omarchy/**/*.sample
/omarchy/plugins/

# fcitx5: generated cache
/fcitx5/conf/cached_layouts

# Superwhisper: credentials, device id, migration markers
/superwhisper/cloud-credentials.json
/superwhisper/cloud-device-id
/superwhisper/cloud-usage.json
/superwhisper/.json-migration-complete

# opencode: contains a password
/opencode/service.json

# git: personal identity and machine-specific credential helpers
/git/local.inc

# Superwhisper: managed file with absolute home path, regenerated by the app
/superwhisper/hypr-block.lua
