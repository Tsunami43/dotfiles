# dankcolors — palette from nvim/dankcolors.lua
# teal-primary, warm cream fg on deep blue-green background

# Main background / foreground
theme[main_bg]="#0d1b1f"
theme[main_fg]="#ebe6c2"

# Title and highlight
theme[title]="#ebe6c2"
theme[hi_fg]="#2ba8b0"

# Menu selection
theme[selected_bg]="#125a61"
theme[selected_fg]="#fff578"

# Inactive text
theme[inactive_fg]="#768283"

# Graph labels
theme[graph_text]="#a8b7b8"

# Meter bar background
theme[meter_bg]="#183238"

# Box borders
theme[cpu_box]="#2ba8b0"
theme[mem_box]="#6bdde4"
theme[net_box]="#ed6696"
theme[proc_box]="#fff578"

# Dividers
theme[div_line]="#234e57"

# Temperature: cold teal -> yellow -> red
theme[temp_start]="#2ba8b0"
theme[temp_mid]="#fff578"
theme[temp_end]="#de5249"

# CPU: green -> amber -> red
theme[cpu_start]="#63d36d"
theme[cpu_mid]="#dcce25"
theme[cpu_end]="#de5249"

# Free memory
theme[free_start]="#63d36d"
theme[free_mid]="#a2f1f6"
theme[free_end]="#2ba8b0"

# Cache
theme[cached_start]="#6bdde4"
theme[cached_mid]="#45bac1"
theme[cached_end]="#2ba8b0"

# Available
theme[available_start]="#fff578"
theme[available_mid]="#dcce25"
theme[available_end]="#d9a141"

# Used
theme[used_start]="#63d36d"
theme[used_mid]="#d9a141"
theme[used_end]="#de5249"

# Network: download
theme[download_start]="#6bdde4"
theme[download_mid]="#2ba8b0"
theme[download_end]="#125a61"

# Network: upload
theme[upload_start]="#ed6696"
theme[upload_mid]="#d9a141"
theme[upload_end]="#fff578"

# Processes (CPU bar in list)
theme[process_start]="#63d36d"
theme[process_mid]="#fff578"
theme[process_end]="#de5249"
